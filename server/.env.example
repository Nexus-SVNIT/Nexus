# Server Configuration
PORT=8081
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/nexus
SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://localhost:5173

# Frontend URL (Used for generating reset password links, verification links, and email button links)
# Production: https://www.nexus-svnit.in
# Local dev: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email Service (Gmail SMTP)
# 1. Use a Google Account with 2-Step Verification enabled
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your full Gmail address and the 16-character app password (without spaces)
EMAIL_ID=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password

# Permanent QR redirect destination for GET /qr
# Set separately in Vercel for each backend environment:
# - Stage backend  (stage branch / Preview)  -> test at https://stage.nexus-svnit.in/qr
# - Production backend (main branch)           -> live at https://www.nexus-svnit.in/qr
QR_REDIRECT_URL=https://docs.google.com/forms/d/e/1FAIpQLSd_gQhAi4Bh9hWV5gqeeHtJsplhhVBoqnXIu5iAv2SlqwDrdQ/viewform
